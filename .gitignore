# Local docs. Contents ignored, but individual files can be re-included below.
# (Git cannot re-include a file whose parent DIRECTORY is excluded, hence /docs/*
# rather than /docs/.)
/docs/*
!/docs/decisions.md

# Snapshot of the owner's live Equalizer APO state. Personal settings, not tracked.
/sim/reference/

# Per-machine endpoint registry backups written by windows/apo/install.ps1.
# These are local safety copies of one machine's audio configuration, not
# project data, and restoring one onto a different machine would be wrong.
/windows/apo/IsoAPO-backup-*.reg

