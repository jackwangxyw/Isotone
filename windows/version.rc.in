//
// The VERSIONINFO every shipped Windows binary carries, configured from
// project(VERSION) so the number lives in exactly one place (stage 6).
//
// Settings, About reads IsoAPO.dll's through this resource
// (ui/backend/diagnostics.h): without it the engine's version there is blank,
// which is what shipped before 0.1.0.
//
// ISOTONE_RC_NAME and ISOTONE_RC_DESCRIPTION are set per target by
// isotone_version_resource() in windows/version.cmake.

#include <winver.h>

#define ISOTONE_RC_VERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#define ISOTONE_RC_VERSION_TEXT "@PROJECT_VERSION@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    ISOTONE_RC_VERSION
PRODUCTVERSION ISOTONE_RC_VERSION
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS      VS_FF_DEBUG
#else
FILEFLAGS      0x0L
#endif
FILEOS         VOS_NT_WINDOWS32
FILETYPE       @ISOTONE_RC_FILETYPE@
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0: US English, Unicode, which is what the Translation value below says.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "The Isotone authors"
            VALUE "FileDescription",  "@ISOTONE_RC_DESCRIPTION@"
            VALUE "FileVersion",      ISOTONE_RC_VERSION_TEXT
            VALUE "InternalName",     "@ISOTONE_RC_NAME@"
            VALUE "LegalCopyright",   "Copyright (C) 2026 The Isotone authors. GPL v2 or later."
            VALUE "OriginalFilename", "@ISOTONE_RC_FILENAME@"
            VALUE "ProductName",      "Isotone"
            VALUE "ProductVersion",   ISOTONE_RC_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
