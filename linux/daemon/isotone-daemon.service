#
# A user unit, not a system one. The daemon belongs to the session: it reads the
# session's PipeWire socket, it writes state under $XDG_CONFIG_HOME, and its
# shared region is the user's. Nothing here needs root, which is the whole
# difference from Windows, where the engine is audiodg running as LocalService.
#
# Install to ~/.config/systemd/user/ (a package puts it in
# /usr/lib/systemd/user/), then:
#
#   systemctl --user enable --now isotone-daemon
#
# With no arguments the daemon follows the default sink and moves applications'
# playback into its own, so the default stays the hardware the desktop shows.
# To pin it to one sink instead, replace the command in a drop-in:
#
#   systemctl --user edit isotone-daemon
#   [Service]
#   ExecStart=
#   ExecStart=/usr/bin/isotone-daemon --sink alsa_output.pci-0000_00_1f.3.analog-stereo
#
# The empty ExecStart= first is how systemd is told to forget the original
# rather than run both.

[Unit]
Description=Isotone system-wide equalizer
Documentation=https://github.com/jackwangxyw/Isotone
After=pipewire.service wireplumber.service
Wants=pipewire.service
# Without this the daemon starts, finds no graph, and sits there doing nothing.
Requisite=pipewire.service

[Service]
Type=simple
# No arguments: follow the default sink. It used to pass --sink ${ISOTONE_SINK},
# which systemd expands to nothing when the variable is unset, leaving --sink
# with no value; the daemon then exits 2 and Restart=on-failure turns that into a
# restart loop until the start limit trips.
ExecStart=/usr/bin/isotone-daemon
Restart=on-failure
RestartSec=2
# The audio thread needs to keep its deadline. rtkit grants this at runtime when
# it is present; the limit has to be here for the request to be allowed at all.
LimitRTPRIO=95
LimitNICE=-19
# It talks to PipeWire and writes one directory. Nothing else.
#
# PrivateDevices= is deliberately not here, and the reason is measured rather
# than guessed (2026-09-20, the GNOME VM on Ubuntu 26.04, systemd 259.5). It
# implies dropping CAP_MKNOD from the capability bounding set, PR_CAPBSET_DROP
# needs CAP_SETPCAP, and a user manager has none: every start failed with
# "Failed to drop capabilities: Operation not permitted", status 218/CAPABILITIES,
# then restarted and failed again. Taking it out is what starts the daemon;
# taking out any of the three below does not. The three are namespace settings,
# which a user manager can do. The daemon opens no device node, so what is lost
# is a second lock on a door it never goes through.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The leading dash: the namespace is built before ExecStart runs, so on a fresh
# install this directory does not exist yet and a hard path would fail the unit
# instead of starting it. The daemon creates it when it first saves.
# $XDG_CONFIG_HOME is not consulted here, so a session that moves it needs this
# line changed in a drop-in as well.
ReadWritePaths=-%h/.config/isotone

[Install]
WantedBy=default.target
