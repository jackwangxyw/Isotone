  <name>Isotone</name>
  <summary>System-wide parametric EQ</summary>

  <description>
    <p>
      Isotone equalises everything the computer plays. It runs as a PipeWire
      filter, so applications need no setting up: their audio goes through it on
      the way to the output.
    </p>
    <p>
      Parametric bands with the usual filter types, a response graph with a live
      spectrum, per-channel bands, speaker setup with bass management and delay,
      and presets that follow the output they were made for.
    </p>
  </description>

  <launchable type="desktop-id">io.github.isotone.Isotone.desktop</launchable>

  <developer id="io.github.jackwangxyw">
    <name>The Isotone authors</name>
  </developer>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>

  <keywords>
    <keyword>equalizer</keyword>
    <keyword>equaliser</keyword>
    <keyword>EQ</keyword>
    <keyword>filter</keyword>
  </keywords>

  <url type="homepage">https://github.com/jackwangxyw/Isotone</url>
  <url type="bugtracker">https://github.com/jackwangxyw/Isotone/issues</url>

  <provides>
    <binary>isotone</binary>
  </provides>

  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>

  <releases>
